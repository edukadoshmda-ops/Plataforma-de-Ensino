# ==============================================================================
# CONFIGURAÇÃO SUPABASE — SEBITAN SAAS (5.000+ ALUNOS)
# Obtenha estas credenciais gratuitamente no painel do Supabase:
# Acesse: https://supabase.com -> Selecione seu Projeto -> Settings -> API
# ==============================================================================

# URL do seu projeto Supabase (Exemplo: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave anônima pública (anon key / public safe)
VITE_SUPABASE_ANON_KEY=sua-chave-anonima-aqui-eyJh...

# (Opcional) Chave da API Google Gemini para o Tutor IA responder com LLM
# VITE_GEMINI_API_KEY=AIzaSy...

# Link público do checkout Asaas (não é uma chave secreta)
# VITE_ASAAS_CHECKOUT_URL=https://www.asaas.com/c/seu-link

# (Opcional para escala) Base URL do Storage externo (Supabase Storage ou Cloudflare R2)
# Se não preenchido, o sistema carrega os PDFs e áudios locais da pasta /public.
# Exemplo Supabase: https://hijdcrelisfmhkbtodyl.supabase.co/storage/v1/object/public/materiais
# VITE_STORAGE_BASE_URL=
